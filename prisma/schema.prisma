// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  cli_id             Int       @id @default(autoincrement())
  cli_identificacion String    @unique @db.VarChar(255)
  cli_nombre         String    @db.VarChar(255)
  cli_apellido       String    @db.VarChar(255)
  cli_email          String    @unique @db.VarChar(255)
  cli_celular        String    @db.VarChar(13)
  cli_direccion      String    @db.VarChar(255)
  cli_observaciones  String    @db.VarChar(255)
  empresa_id         Int // ← para multitenencia
  activo             Boolean   @default(true)
  createdBy          Int?
  updatedBy          Int?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  //relacion con mascotas
  mascotas           Mascota[]
}

model Mascota {
  mas_id           Int       @id @default(autoincrement())
  mas_nombre       String    @db.VarChar(255)
  mas_fechaNac     DateTime?
  mas_peso         Float?
  mas_color        String?   @db.VarChar(255)
  mas_esterilizado Boolean   @default(false)
  mas_microchip    String?   @unique @db.VarChar(255)
  mas_foto         String?   @db.VarChar(255) // ← URL o nombre de archivo
  mas_notas        String?   @db.VarChar(255)

  especie_id Int
  raza_id    Int
  cliente_id Int
  empresa_id Int

  activo     Boolean  @default(true)
  createdBy  Int?
  updatedBy  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  especie         Especie          @relation(fields: [especie_id], references: [esp_id])
  raza            Raza             @relation(fields: [raza_id], references: [raz_id])
  propietario     Cliente          @relation(fields: [cliente_id], references: [cli_id])
  historiaClinica HistoriaClinica?
  Consulta        Consulta[]
}

model HistoriaClinica {
  hic_id           Int    @id @default(autoincrement())
  hic_numero_local Int // Número de historia dentro de la empresa
  hic_estado       String @default("Abierta") @db.VarChar(50)
  mascota_id       Int    @unique

  empresa_id Int
  activo     Boolean  @default(true)
  createdBy  Int?
  updatedBy  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  mascota   Mascota    @relation(fields: [mascota_id], references: [mas_id])
  consultas Consulta[]
}

model Consulta {
  con_id                     Int      @id @default(autoincrement())
  con_numero_mascota         Int? // Número secuencial por mascota
  con_fecha                  DateTime @default(now())
  mascota_id                 Int?
  mascota                    Mascota? @relation(fields: [mascota_id], references: [mas_id])
  con_motivo                 String   @db.VarChar(255)
  con_peso                   Float?
  con_temperaturaCorporal    Float?
  con_icc                    String?
  con_pulso                  Int?
  con_frecuenciaRespiratoria Int? //respiraciones por minutos F.R.
  con_frecuenciaCardiaca     Int? //latidos por minutoF.C.
  con_hidratacion            String?  @db.VarChar(255)
  con_mucosas                String?  @db.VarChar(255)
  con_campoPulmonar          String?  @db.VarChar(255)
  con_palpacionAbdominal     String?  @db.VarChar(255)
  con_diagnosticoPresuntivo  String?  @db.VarChar(255)
  con_observaciones          String?  @db.VarChar(255)
  con_recomendaciones        String?  @db.VarChar(255)

  historiaClinica_id Int
  empresa_id         Int
  activo             Boolean  @default(true)
  createdBy          Int?
  updatedBy          Int?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  historiaClinica    HistoriaClinica     @relation(fields: [historiaClinica_id], references: [hic_id])
  vacunas            Vacuna[]
  ConsultasPatologia ConsultaPatologia[] // 👈 Diagnóstico real
  Tratamiento        Tratamiento[]
  Examen             Examen[]
}

model Vacuna {
  vac_id          Int       @id @default(autoincrement())
  vac_nombre      String    @db.VarChar(255)
  vac_tipo        String    @db.VarChar(100)
  vac_fecha       DateTime
  vac_proxima     DateTime?
  vac_lote        String?   @db.VarChar(100)
  vac_foto        String?   @db.VarChar(255) // URL o nombre de archivo
  vac_observacion String?   @db.VarChar(255)

  consulta_id Int
  empresa_id  Int
  activo      Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  consulta   Consulta     @relation(fields: [consulta_id], references: [con_id])
  VacunaFoto VacunaFoto[]
}

model Especie {
  esp_id     Int    @id @default(autoincrement())
  esp_nombre String @unique @db.VarChar(255)

  empresa_id Int
  activo     Boolean  @default(true)
  createdBy  Int?
  updatedBy  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  razas                Raza[]
  mascotas             Mascota[]
  EspecieRazaPatologia EspecieRazaPatologia[]
}

model Raza {
  raz_id     Int    @id @default(autoincrement())
  raz_nombre String @db.VarChar(255)
  especie_id Int

  empresa_id Int
  activo     Boolean  @default(true)
  createdBy  Int?
  updatedBy  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  especie              Especie                @relation(fields: [especie_id], references: [esp_id])
  mascotas             Mascota[]
  EspecieRazaPatologia EspecieRazaPatologia[]
}

model Patologia {
  pat_id     Int     @id @default(autoincrement())
  pat_nombre String  @db.VarChar(255)
  pat_desc   String? @db.VarChar(255)

  empresa_id Int
  activo     Boolean  @default(true)
  createdBy  Int?
  updatedBy  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  especieRelaciones EspecieRazaPatologia[]
  ConsultaPatologia ConsultaPatologia[]
}

model EspecieRazaPatologia {
  erp_id       Int @id @default(autoincrement())
  especie_id   Int
  raza_id      Int
  patologia_id Int

  empresa_id Int
  activo     Boolean  @default(true)
  createdBy  Int?
  updatedBy  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  especie   Especie   @relation(fields: [especie_id], references: [esp_id])
  raza      Raza      @relation(fields: [raza_id], references: [raz_id])
  patologia Patologia @relation(fields: [patologia_id], references: [pat_id])
}

model ConsultaPatologia {
  cp_id        Int @id @default(autoincrement())
  consulta_id  Int
  patologia_id Int

  empresa_id Int
  activo     Boolean  @default(true)
  createdBy  Int?
  updatedBy  Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  consulta  Consulta  @relation(fields: [consulta_id], references: [con_id])
  patologia Patologia @relation(fields: [patologia_id], references: [pat_id])
}

model VacunaFoto {
  vf_id       Int     @id @default(autoincrement())
  vac_id      Int
  url         String  @db.VarChar(255) // puede ser nombre de archivo o ruta
  descripcion String? @db.VarChar(255)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  vacuna Vacuna @relation(fields: [vac_id], references: [vac_id])

  @@map("vacuna_foto")
}

model Tratamiento {
  tra_id      Int      @id @default(autoincrement())
  consulta_id Int // FK a la consulta
  mascota_id  Int // útil para trazabilidad
  empresa_id  Int
  activo      Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  consulta     Consulta      @relation(fields: [consulta_id], references: [con_id])
  medicamentos Medicamento[]
}

model Medicamento {
  med_id         Int    @id @default(autoincrement())
  tratamiento_id Int // FK a tratamiento
  med_nombre     String @db.VarChar(255)
  med_dosis      String @db.VarChar(255)

  empresa_id Int

  createdBy Int?
  updatedBy Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tratamiento Tratamiento @relation(fields: [tratamiento_id], references: [tra_id])
}

model Examen {
  exam_id     Int      @id @default(autoincrement())
  consulta_id Int
  exam_tipo   String // Patológica, Rayos X, etc.
  empresa_id  Int
  activo      Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  archivos ExamenArchivo[]

  consulta Consulta @relation(fields: [consulta_id], references: [con_id])
  @@unique([consulta_id, exam_tipo], name: "consulta_id_tipo")
}

model ExamenArchivo {
  exa_id          Int      @id @default(autoincrement())
  examen_id       Int
  exa_categoria   String // 'solicitud' o 'resultado'
  exa_url         String
  exa_descripcion String
  empresa_id      Int
  createdBy       Int?
  updatedBy       Int?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  examen Examen @relation(fields: [examen_id], references: [exam_id])
}
