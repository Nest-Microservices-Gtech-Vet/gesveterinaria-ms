generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Propietario {
  prop_id             Int      @id @default(autoincrement())
  prop_identificacion String   @unique @db.VarChar(255)
  prop_nombre         String   @db.VarChar(255)
  prop_apellido       String   @db.VarChar(255)
  prop_email          String   @unique @db.VarChar(255)
  prop_celular        String   @db.VarChar(13)
  prop_direccion      String   @db.VarChar(255)
  prop_observaciones  String   @db.VarChar(255)
  empresa_id          Int // ← para multitenencia
  activo              Boolean  @default(true)
  createdBy           Int?
  updatedBy           Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}
